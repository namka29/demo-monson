# Copy this file to `.env` when working only with Docker Compose (or merge into `.env`).
# Matches services defined in compose.yml (app, nginx, mysql).

APP_NAME="Môn Sơn"
TOURISM_HEADLINE_LINE1="Cổng thông tin du lịch"
TOURISM_HEADLINE_LINE2="xã Môn Sơn, Nghệ An"
APP_ENV=local
# Leave empty — the `app` container runs `key:generate` on first boot; or run manually:
# docker compose exec app php artisan key:generate --force
APP_KEY=
APP_DEBUG=true
# Must match nginx URL (default http://localhost:8080). If you change APP_PORT in Compose, update APP_URL here.
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# MySQL on the Docker network (hostname is the service name)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tourist_web
DB_USERNAME=tourist
DB_PASSWORD=tourist_dev

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# Livewire (Compose đã set mặc định). PHP: docker/php/conf.d/uploads.ini — rebuild image sau khi sửa.
#LIVEWIRE_TEMP_UPLOAD_MAX_KB=32768
#LIVEWIRE_PAYLOAD_MAX_BYTES=10485760

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Câu lệnh Docker (tham chiếu nhanh) ---
# ./scripts/docker-setup.sh
# docker compose up -d
# ./scripts/docker-npm.sh install && ./scripts/docker-npm.sh run build
# ./scripts/docker-npm-dev.sh
# docker compose exec app php artisan migrate
# (Không dùng: docker compose exec app npm … — container app không có npm; dùng ./scripts/docker-npm.sh thay thế.)
