APP_NAME="Môn Sơn"
TOURISM_HEADLINE_LINE1="Cổng thông tin du lịch"
TOURISM_HEADLINE_LINE2="xã Môn Sơn, Nghệ An"
# TOURISM_SITE_TITLE=...  # tuỳ chọn: ghi đè chuỗi dùng cho <title> mặc định, ©, Filament
# TOURISM_HERO_SLIDE_AUTOPLAY_MS=6500  # banner trang chủ: thời gian mỗi slide (0 = chỉ nút và phím ← →).
# TOURISM_TRUSTED_DEVICE_DAYS=30  # admin: ghi nhớ thiết bị đã xác thực TOTP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (local/dev): run `docker compose up -d mysql` and keep DB_* aligned below,
# or point to your own MySQL server.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tourist_web
DB_USERNAME=tourist
DB_PASSWORD=tourist_dev

# Full Docker stack (nginx + php + mysql): copy `.env.docker` to `.env`
# and run `./scripts/docker-setup.sh` — `DB_HOST=mysql` is set in `compose.yml`.

# SQLite fallback (comment MySQL block above and uncomment below if not using MySQL):
# DB_CONNECTION=sqlite

# Use database sessions when MySQL is available (recommended for Docker / PHP-FPM).
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Filesystem: local disk (Laravel default disks: local / public).
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Site frontend (optional — tourism portal style header/footer)
TOURISM_HOTLINE=
TOURISM_HOTLINE_HOURS=
TOURISM_SUPPORT_EMAIL=
TOURISM_HERO_TAGLINE=
# Ảnh nền banner trang chủ (URL), tuỳ chọn — mặc định dùng ảnh minh họa trong config/tourist.php
TOURISM_HERO_IMAGE_URL=

# Bản đồ điểm đến: google (iframe, không key) | leaflet (OpenStreetMap)
TOURISM_MAPS_DRIVER=google
